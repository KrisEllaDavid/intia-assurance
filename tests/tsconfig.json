{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "jsonwebtoken":      ["node_modules/jsonwebtoken"],
      "bcryptjs":          ["node_modules/bcryptjs"],
      "@apollo/server":    ["node_modules/@apollo/server"],
      "@apollo/server/*":  ["node_modules/@apollo/server/*"],
      "graphql":           ["node_modules/graphql"]
    }
  },
  "include": ["./**/*.ts"]
}
